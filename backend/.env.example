# ============================================
# CONFIGURACION AWS
# ============================================

# Region de AWS donde esta tu DynamoDB
AWS_REGION=us-east-1

# Credenciales AWS (obtener desde AWS Console > Security Credentials)
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui

# ============================================
# CONFIGURACION DYNAMODB
# ============================================

# Nombre de la tabla de DynamoDB
DYNAMODB_TABLE_NAME=n8n_table_state_users

# Nombre del Global Secondary Index
DYNAMODB_GSI_NAME=email

# ============================================
# CONFIGURACION DEL SERVIDOR
# ============================================

# Puerto del backend
PORT=3001

# URL del frontend para CORS
FRONTEND_URL=http://localhost:5173
